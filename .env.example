# =====================================================================
# 小语手记 · Flask 主站环境变量模板
# 使用方法：复制本文件为 .env，填入本地真实配置；.env 不会被提交到 git
#
# 变量读取方：app/config/config.py、app/settings.py、app/app.py、controller/ai.py
# 容器部署时 docker-compose.full.yml 的 environment 会覆盖其中的连接类变量，
# 因此容器环境无需手改 .env。
# =====================================================================

# ---- MySQL 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=xiaoyushouji
DB_CHARSET=utf8mb4

# ---- 邮箱（QQ 邮箱填 SMTP 授权码，不是登录密码） ----
MAIL_USERNAME=your_email@qq.com
MAIL_PASSWORD=your_smtp_auth_code

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 无密码留空即可
REDIS_PASSWORD=
REDIS_DB=1

# ---- Flask 运行环境（test / production） ----
FLASK_ENV=production

# ---- Flask 会话密钥（python -c "import secrets;print(secrets.token_hex(24))" 生成） ----
SECRET_KEY=your-flask-secret-key

# ---- AI 网关 ----
# 本地开发 main.py 会在 127.0.0.1:8100 拉起 AI 子进程；容器内由 compose 覆盖
AI_SERVICE_URL=http://127.0.0.1:8100
# 必须与 services/ai_service/.env 中的 INTERNAL_TOKEN 完全一致
AI_INTERNAL_TOKEN=change-me-to-a-random-string

# ---- 启动控制（可选，main.py 读取；不设则用默认值） ----
# 是否由 main.py 自动拉起 AI 子进程：本地默认 1，容器内默认 0
# START_AI_CHILD=1
# Flask 监听地址 / 端口（本地默认 127.0.0.1:5000；Dockerfile 会注入 0.0.0.0）
# FLASK_RUN_HOST=127.0.0.1
# FLASK_RUN_PORT=5000
# 注：RUNNING_IN_DOCKER=1 由 Dockerfile 自动设置，无需写在此文件中
