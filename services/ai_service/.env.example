# =====================================================================
# AI 服务（services/ai_service）环境变量模板
# 使用方法：复制本文件为同目录 .env，填入真实值；.env 不会被提交到 git
#
# 变量读取方：ai_app/config.py（pydantic-settings）
# 容器部署时 docker-compose.full.yml 的 environment 会覆盖：
#   QDRANT_URL / REDIS_URL / EMBED_BASE_URL / INTERNAL_TOKEN / MYSQL_DSN
# 因此容器内这些变量以 compose 为准，本文件只需保证云服务 Key 正确。
# =====================================================================

# ---- 双机 IP（本地开发参考用） ----
VM_IP=192.168.56.200
WIN_IP=192.168.56.1

# ---- 内部鉴权 ----
# 必须与主站根目录 .env 的 AI_INTERNAL_TOKEN 完全一致
INTERNAL_TOKEN=change-me-to-a-random-string

# ---- 云服务 API Key ----
# 通义 DashScope（LLM）
LLM_API_KEY=sk-xxxx
# 硅基流动（Rerank）
RERANK_API_KEY=sk-xxxx
# Dify：预留项。当前运行时不读取（ai_app/config.py 对多余变量 extra=ignore；
# scripts/import_to_dify.py 使用脚本内硬编码配置），不用可留空或删除本行
DIFY_API_KEY=app-xxxx

# ---- 主站 MySQL（只读，语料同步脚本 scripts/sync_corpus.py 使用） ----
# 本地开发示例；容器内由 compose 覆盖为 host.docker.internal:3306
# MYSQL_DSN=mysql+pymysql://user:password@127.0.0.1:3307/xiaoyushouji?charset=utf8mb4

# ---- 服务地址（默认值已写在 ai_app/config.py，如需覆盖再填） ----
# EMBED_BASE_URL=http://127.0.0.1:11434/v1
# QDRANT_URL=http://192.168.56.200:6333
# REDIS_URL=redis://192.168.56.200:6379/0
